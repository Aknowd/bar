{{- $.Scratch.Add "updates" slice -}}

{{- range (where .Site.RegularPages "Section" "updates") -}}
  {{- $.Scratch.Add "updates" (dict
      "date" (.Date.Format "0102")
      "title" .Title
      "link" .Params.link
      "count" .Params.count
  ) -}}
{{- end -}}

{{- $.Scratch.Get "updates" | jsonify -}}
